# Database
DATABASE_URL=postgresql://username:***@localhost:5432/nexus_mining

# Blockchain
BASE_RPC_URL=https://mainnet.base.org
PLATFORM_TREASURY_WALLET=0x0000000000000000000000000000000000000000

# API Security
INTERNAL_SECRET_API_KEY=change_this_to_a_long_random_string

# Marketplace provider: which hashrate marketplace places upgrade orders.
# nicehash (default) | mrr
# MARKETPLACE_PROVIDER=nicehash

# NiceHash Marketplace Integration
# Get these from NiceHash: Settings → API Keys (create with 'Order' permission),
# and register a mining pool under your account to get the poolId.
NICEHASH_API_KEY=your_nicehash_api_key
NICEHASH_API_SECRET=your_nicehash_api_secret
NICEHASH_ORG_ID=your_nicehash_organization_id
NICEHASH_POOL_ID=your_registered_pool_id

# Environment: 'main' (real marketplace, requires NODE_ENV=production for live
# orders) or 'test' (FREE testnet at test.nicehash.com / api-test.nicehash.com —
# test BTC, no real funds. Great for a zero-cost test-mine session before paying
# for anything).
# NICEHASH_ENV=main

# SAFETY RAIL: real orders are only placed when ALL of these hold:
#   keys set above AND NICEHASH_LIVE_ORDERS=1 AND (NICEHASH_ENV=test OR NODE_ENV=production)
# In development (NODE_ENV != production) orders are SIMULATED in sandbox mode.
NICEHASH_LIVE_ORDERS=0

# Optional: override NiceHash order pricing/speed (defaults come from the
# marketplace buy/info endpoint). Values are in BTC per market unit and market
# units respectively.
# NICEHASH_ORDER_PRICE=0.0001
# NICEHASH_ORDER_LIMIT=0

# NiceHash marketplace region (EU or USA). Default: EU
# NICEHASH_MARKET=EU

# MiningRigRentals (MRR) — alternative hashrate marketplace.
# Set MARKETPLACE_PROVIDER=mrr to route orders here instead of NiceHash.
# Get keys from your MRR account (API section), then create ONE pool profile
# per algorithm in the account (pointed at your Nexus pool) and put its id below.
# SAFETY RAIL: real orders only when keys set AND MRR_LIVE_ORDERS=1
# AND NODE_ENV=production (no testnet on MRR).
MRR_API_KEY=your_mrr_api_key
MRR_API_SECRET=your_mrr_api_secret
MRR_LIVE_ORDERS=0
MRR_POOL_PROFILE_ZHASH=
MRR_POOL_PROFILE_KHEAVYHASH=
MRR_POOL_PROFILE_SCRYPT=

# Price oracle: TTL for cached BTC/USDC spot (ms). Default 30000.
PRICE_CACHE_TTL_MS=30000

# Live miner monitor: URL of the local XMRig HTTP API (dashboard proxies it).
# Set DATABASE_SSL=false when Postgres runs on the same machine (local/droplet).
XMRIG_API_URL=http://127.0.0.1:8080/1/summary
# DATABASE_SSL=false

# Server
PORT=3000
# Development = sandbox orders. Production + NICEHASH_LIVE_ORDERS=1 = real orders.
NODE_ENV=development
