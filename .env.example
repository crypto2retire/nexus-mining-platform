# Database
DATABASE_URL=postgresql://username:***@localhost:5432/nexus_mining

# Blockchain
BASE_RPC_URL=https://mainnet.base.org
# Player USDC deposits land here (Base network). MUST be a real wallet the
# operator controls — the zero address is a burn address and deposits are
# disabled until this is a valid non-zero address.
PLATFORM_TREASURY_WALLET=0xe79E3249B8d86067fc4E95efDE72ED9cDf6D452a

# API Security
INTERNAL_SECRET_API_KEY=change_this_to_a_long_random_string
# Signs 24-hour wallet sessions. Generate a unique random value of 32+ characters.
JWT_SECRET=
# Separate operator credential for admin routes. Generate a unique random value of 32+ characters.
ADMIN_API_KEY=

# Marketplace provider: which hashrate marketplace places upgrade orders.
# nicehash (default) | mrr
# MARKETPLACE_PROVIDER=nicehash

# NiceHash Marketplace Integration
# Get these from NiceHash: Settings → API Keys (create with 'Order' permission),
# and register a mining pool under your account to get the poolId.
NICEHASH_API_KEY=your_nicehash_api_key
NICEHASH_API_SECRET=your_nicehash_api_secret
NICEHASH_ORG_ID=your_nicehash_organization_id
NICEHASH_POOL_ID=your_registered_pool_id

# Environment: 'main' (real marketplace, requires NODE_ENV=production for live
# orders) or 'test' (FREE testnet at test.nicehash.com / api-test.nicehash.com —
# test BTC, no real funds. Great for a zero-cost test-mine session before paying
# for anything).
# NICEHASH_ENV=main

# SAFETY RAIL: real orders are only placed when ALL of these hold:
#   keys set above AND NICEHASH_LIVE_ORDERS=1 AND (NICEHASH_ENV=test OR NODE_ENV=production)
# In development (NODE_ENV != production) orders are SIMULATED in sandbox mode.
NICEHASH_LIVE_ORDERS=0

# Optional: override NiceHash order pricing/speed (defaults come from the
# marketplace buy/info endpoint). Values are in BTC per market unit and market
# units respectively.
# NICEHASH_ORDER_PRICE=0.0001
# NICEHASH_ORDER_LIMIT=0

# NiceHash marketplace region (EU or USA). Default: EU
# NICEHASH_MARKET=EU

# MiningRigRentals (MRR) — alternative hashrate marketplace.
# Set MARKETPLACE_PROVIDER=mrr to route orders here instead of NiceHash.
# Get keys from your MRR account (API section), then create ONE pool profile
# per algorithm in the account (pointed at your Nexus pool) and put its id below.
# SAFETY RAIL: real orders only when keys set AND MRR_LIVE_ORDERS=1
# AND NODE_ENV=production (no testnet on MRR).
MRR_API_KEY=your_api_key
MRR_API_SECRET=your_mrr_api_secret
MRR_LIVE_ORDERS=0
MRR_POOL_PROFILE_EQUIHASH=
MRR_POOL_PROFILE_KHEAVYHASH=
MRR_POOL_PROFILE_SCRYPT=
MRR_POOL_PROFILE_RANDOMX=

# Price oracle: TTL for cached BTC/USDC spot (ms). Default 30000.
PRICE_CACHE_TTL_MS=30000

# MRR (MiningRigRentals) provider — platform wallets for rented hashrate payouts.
# ZEC (zhash), KAS (kheavyhash), LTC (scrypt), XMR (randomx).
# MRR_API_KEY/MRR_API_SECRET live on the droplet .env (not committed).
MRR_PLATFORM_WALLET_ZEC=t1V5oarvihbomZswPw381AowjPpGj1t2B3K
MRR_PLATFORM_WALLET_KAS=kaspa:qrdpuucrld27uu0zvkxnhhhxtg2tr23dlknqqg65pa2740lxqqqqgg4qruwnn
# HeroMiners KASPA payout threshold in KAS.
KASPA_MIN_PAYOUT=1
MRR_PLATFORM_WALLET_LTC=ltc1qgmzgwjndpqtsvx8wv24d0038c6fh7msrvjuph0
MRR_PLATFORM_WALLET_DOGE=DRVFjWjcQtfZKbXRi3VbF64iUkRpDuF5nd
# XMR platform wallet — mines at herominers (unpaid-drop payout watch).
XMR_WALLET_ADDRESS=43iF2iW82XCTKrS65Nod5NieyX2fvgDSWYBbr7mVT3GsducRXFEn58pCPXcKM88aS2fXMoJAmkVm4TV3LKndWBT8LJC8t1B
# MRR pool profile ids (created in MRR account Pools page):
# MRR_POOL_PROFILE_ZHASH=<id>
# MRR_POOL_PROFILE_KHEAVYHASH=<id>
# MRR_POOL_PROFILE_SCRYPT=<id>
# MRR_POOL_PROFILE_RANDOMX=<id>
# DATABASE_SSL=false

# Server
PORT=3000
# Development = sandbox orders. Production + NICEHASH_LIVE_ORDERS=1 = real orders.
NODE_ENV=development

# GoMiner rental scheduler (010) — re-rents real hashpower for ACTIVE rigs
# using only each rig's collected maintenance (or the owner's OK'd USDC).
# RENTAL_SCHEDULER_ENABLED=1 turns the loop on (default off).
# RENTAL_DAILY_SPEND_CAP_USD caps total real spend per UTC day (default 20).
# RENTAL_SCHEDULER_INTERVAL_MS = tick interval (default 15 min).
# MRR_MAX_RENTAL_HOURS = max rental length per order (default 72; scheduler caps dud exposure).
# RENTAL_SCHEDULER_ENABLED=1
# RENTAL_DAILY_SPEND_CAP_USD=20
